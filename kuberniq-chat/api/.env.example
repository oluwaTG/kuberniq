# MCP Server
MCP_SERVER_URL=http://localhost:5165
MCP_USERNAME=admin
MCP_PASSWORD=your-mcp-server-password

# LLM — set the model and the corresponding provider API key
# OpenAI:
LLM_MODEL=gpt-4o
FAST_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# Anthropic (uncomment and set LLM_MODEL=claude-opus-4-5 etc.):
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (LLM_MODEL=gemini/gemini-1.5-pro):
# GEMINI_API_KEY=...

# Groq (LLM_MODEL=groq/llama-3.3-70b-versatile):
# GROQ_API_KEY=...

# Chat app data directory (default: ./data)
KUBERNIQ_DATA_DIR=./data

# Show raw MCP context in the UI for debugging
# DEBUG_MCP=true
